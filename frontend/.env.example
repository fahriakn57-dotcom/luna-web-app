# Points at the SHARED backend from luna-main (backend/luna) — the same one
# the mobile app talks to. luna.com-main's own backend/server.py is no
# longer used by this frontend; see the pairing flow in src/lib/api.js.
REACT_APP_BACKEND_URL=http://localhost:8000

# Google Sign-In (Identity Services ID-token flow, see src/pages/AccountGate.jsx).
# This is the OAuth 2.0 "Web application" Client ID from Google Cloud
# Console — safe to expose to the browser (Google's own docs: the Client ID
# itself isn't a secret). Must match GOOGLE_CLIENT_ID on the backend exactly.
REACT_APP_GOOGLE_CLIENT_ID=
